// Bài 5 — Chuẩn bị dữ liệu quan hệ 1-n (restaurants + items)
// Chạy: mongosh db_java_t3h_module3 < 01-create-sample-data.mongodb

use db_java_t3h_module3;

db.restaurants.deleteMany({});
db.items.deleteMany({});

db.restaurants.insertMany([
  {
    restaurant_id: "30075445",
    name: "Morris Park Bake Shop",
    borough: "Bronx",
    cuisine: "Bakery"
  },
  {
    restaurant_id: "40356018",
    name: "Wild East",
    borough: "Brooklyn",
    cuisine: "Chinese"
  },
  {
    restaurant_id: "40363171",
    name: "Carnegie Diner",
    borough: "Manhattan",
    cuisine: "American"
  }
]);

db.items.insertMany([
  { restaurant_id: "30075445", name: "Cheeseburger", description: "Classic beef burger", price: 8.99, category: "Main" },
  { restaurant_id: "30075445", name: "Fries", description: "Crispy fries", price: 3.49, category: "Side" },
  { restaurant_id: "30075445", name: "Chocolate Cake", description: "House dessert", price: 5.99, category: "Dessert" },
  { restaurant_id: "40356018", name: "Kung Pao Chicken", description: "Spicy stir-fry", price: 12.50, category: "Main" },
  { restaurant_id: "40356018", name: "Spring Rolls", description: "Vegetable rolls", price: 4.50, category: "Appetizer" },
  { restaurant_id: "40363171", name: "Club Sandwich", description: "Triple-decker", price: 11.00, category: "Main" },
  { restaurant_id: "40363171", name: "Caesar Salad", description: "Fresh greens", price: 9.50, category: "Side" }
]);

// Index khóa liên kết (§5 syllabus)
db.items.createIndex({ restaurant_id: 1 });
db.restaurants.createIndex({ restaurant_id: 1 });

print("Seeded restaurants:", db.restaurants.countDocuments());
print("Seeded items:", db.items.countDocuments());
