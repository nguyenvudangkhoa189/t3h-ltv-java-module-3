// Index field hay query / khóa liên kết (§2 syllabus)
db.restaurants.createIndex({ restaurant_id: 1 });
db.restaurants.createIndex({ borough: 1 });
db.items.createIndex({ restaurant_id: 1 });

// Text index cho $text search (§4.3) — mỗi collection chỉ một text index
db.restaurants.createIndex({ name: "text", cuisine: "text" });

print("Seeded restaurants:", db.restaurants.countDocuments());
print("Seeded items:", db.items.countDocuments());
print("Indexes restaurants:", db.restaurants.getIndexes().length);
print("Indexes items:", db.items.getIndexes().length);
